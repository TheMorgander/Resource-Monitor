<UserControl x:Class="ResourceMonitor.Views.Settings.General"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <StackPanel
            x:Name="GeneralStackPanel"
            Orientation="Vertical">
            <TextBlock
                x:Name="GeneraTextBlock"
                Text="General Settings"
                FontSize="16"
                FontWeight="Bold"
                TextAlignment="Center"
                Background="LightGray"
                Margin="2">
            </TextBlock>

            <StackPanel
                x:Name="GeneralRefreshFrequencyStackPanel"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="GeneralRefreshFrequencyTextBlock"
                    Text="Refresh Frequency"
                    Width="125"
                    Margin="2">
                </TextBlock>
                <TextBox
                    x:Name="GeneralRefreshFrequencyTextBox"
                    Text="{Binding GeneralRefreshFrequency}"
                    Width="75"
                    Height="20"
                    Margin="2">
                </TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Text="Display Mode"
                    Width="125"
                    Margin="2"
                    VerticalAlignment="Center">
                </TextBlock>
                <ComboBox
                    ItemsSource="{Binding DisplayModeOptions}"
                    SelectedItem="{Binding DisplayMode}"
                    Width="100"
                    Height="22"
                    Margin="2">
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Text="Window Position"
                    Width="125"
                    Margin="2"
                    VerticalAlignment="Center">
                </TextBlock>
                <ComboBox
                    ItemsSource="{Binding WindowPositionOptions}"
                    SelectedItem="{Binding WindowPosition}"
                    Width="100"
                    Height="22"
                    Margin="2">
                </ComboBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>